{
  "manifest_version": 3,
  "name": "iChess Assistant & Auto-Player",
  "version": "5.0.0",
  "description": "Real-time Stockfish engine overlay & assist for Chess.com",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://www.chess.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.chess.com/*"],
      "js": ["main-world.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.chess.com/*"],
      "js": ["chess.js", "content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "iChess Settings",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["stockfish.js", "main-world.js", "icon16.png", "icon48.png", "icon128.png"],
      "matches": ["https://www.chess.com/*"]
    }
  ]
}
