{
  "manifest_version": 3,
  "name": "iChess Assistant & Auto-Player",
  "version": "1.0.0",
  "description": "Real-time Stockfish engine overlay & assist for Chess.com",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://www.chess.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.chess.com/*"],
      "js": ["chess.js", "content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "iChess Settings"
  },
  "web_accessible_resources": [
    {
      "resources": ["stockfish.js"],
      "matches": ["https://www.chess.com/*"]
    }
  ]
}
